{
  "name": "osnova-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "osnova/packages/ui/src",
  "tags": ["type:lib", "product:osnova"],
  "targets": {
    "graphql-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["graphqlGeneration"],
      "outputs": ["{projectRoot}/src/app/generated"],
      "options": {
        "command": "tsx osnova/tools/graphql/graphql-operator.mts",
        "cwd": "."
      }
    }
  }
}
