generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(200)
  kind TenantKind @default(CUSTOMER)
  status AccountStatus @default(ACTIVE)
  branches Branch[]
  users User[]
  sessions Session[]
  merchantProvisionings MerchantProvisioning[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@map("tenant")
}

model Branch {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name String @db.VarChar(200)
  status AccountStatus @default(ACTIVE)
  merchantProvisionings MerchantProvisioning[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([tenantId, id])
  @@index([tenantId, name, id])
  @@map("branch")
}

model MerchantProvisioning {
  platformTenantId String @db.Uuid
  operationId String @db.Uuid
  merchantTenantId String @db.Uuid
  branchId String @db.Uuid
  merchantName String @db.VarChar(200)
  adminName String @db.VarChar(200)
  adminEmail String @db.VarChar(254)
  branchName String @db.VarChar(200)
  platformTenant Tenant @relation(fields: [platformTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch @relation(fields: [merchantTenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  @@id([platformTenantId, operationId])
  @@map("merchantProvisioning")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  email String @unique @db.VarChar(254)
  name String @db.VarChar(200)
  passwordHash String
  role UserRole @default(VIEWER)
  active Boolean @default(true)
  lastSignInAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sessions Session[]
  @@unique([tenantId, id])
  @@index([tenantId, name, id])
  @@map("user")
}

enum TenantKind {
  CUSTOMER @map("customer")
  PLATFORM @map("platform")
  @@map("tenantKind")
}

enum AccountStatus {
  ACTIVE @map("active")
  SUSPENDED @map("suspended")
  @@map("accountStatus")
}

enum UserRole {
  SALES @map("sales")
  VIEWER @map("viewer")
  OPERATOR @map("operator")
  ENGINEER @map("engineer")
  ADMINISTRATOR @map("administrator")
  @@map("userRole")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId String @db.Uuid
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash String @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([tenantId, userId])
  @@map("session")
}
