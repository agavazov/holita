{
  "name": "holita-admin",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "holita/apps/admin/src",
  "tags": ["type:app", "product:holita"],
  "implicitDependencies": ["holita-gateway", "holita-operator"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["osnova-ui"],
          "target": "graphql-generate"
        },
        {
          "projects": ["holita-gateway"],
          "target": "graphql-generate"
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npm run build",
        "cwd": "holita/apps/admin"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["osnova-ui"],
          "target": "graphql-generate"
        },
        {
          "projects": ["holita-gateway"],
          "target": "graphql-generate"
        }
      ],
      "options": {
        "command": "npm run typecheck",
        "cwd": "holita/apps/admin"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "npm run dev",
        "cwd": "holita/apps/admin"
      }
    },
    "test-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "holita-admin",
            "holita-backoffice",
            "holita-sales",
            "holita-sales-api",
            "holita-gateway",
            "holita-commerce",
            "osnova-core",
            "holita-storefront"
          ]
        }
      ],
      "options": {
        "command": "playwright test --config holita/tools/browser/playwright.config.mts",
        "cwd": ".",
        "forwardAllArgs": true
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "{workspaceRoot}/holita/packages/operator/**/*",
      "{workspaceRoot}/osnova/packages/ui/**/*",
      "{workspaceRoot}/holita/apps/commerce/src/**/*.graphql",
      "{workspaceRoot}/osnova/apps/core/src/**/*.graphql"
    ]
  }
}
