{
  "name": "holita-gateway",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "holita/apps/gateway/router",
  "implicitDependencies": ["holita-commerce", "osnova-core"],
  "tags": ["type:app", "product:holita"],
  "targets": {
    "build": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["graphql-generate"]
    },
    "graphql-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/holita/tools/graphql/**/*",
        "{workspaceRoot}/holita/apps/commerce/src/**/*.graphql",
        "{workspaceRoot}/holita/packages/operator/src/**/*.graphql",
        "{workspaceRoot}/osnova/apps/core/src/**/*.graphql",
        "{workspaceRoot}/osnova/packages/ui/src/app/**/*.graphql",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/holita/apps/storefront/src/**/*.graphql"
      ],
      "outputs": [
        "{projectRoot}/src/generated/graphql",
        "{workspaceRoot}/holita/packages/operator/src/generated",
        "{projectRoot}/src/generated/storefront",
        "{workspaceRoot}/holita/apps/storefront/src/generated"
      ],
      "options": {
        "command": "tsx tools/holita-graphql.mts",
        "cwd": "."
      }
    }
  }
}
