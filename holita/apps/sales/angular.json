{
  "$schema": "../../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sales": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/",
                "ignore": ["config.local.json"]
              },
              {
                "glob": "**/*",
                "input": "public/fonts/lato",
                "output": "fonts/lato",
                "followSymlinks": true
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["../../../osnova/packages/ui/src/styles"]
            }
          },
          "configurations": {
            "development": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "output": "/"
                },
                {
                  "glob": "**/*",
                  "input": "public/fonts/lato",
                  "output": "fonts/lato",
                  "followSymlinks": true
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "sales:build:development",
            "host": "127.0.0.1",
            "port": 12002,
            "proxyConfig": "proxy.conf.mjs"
          }
        }
      }
    }
  }
}
