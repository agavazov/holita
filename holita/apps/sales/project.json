{
  "name": "holita-sales",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "holita/apps/sales/src",
  "tags": ["type:app", "product:holita"],
  "implicitDependencies": ["holita-gateway", "holita-operator"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["osnova-ui"],
          "target": "graphql-generate"
        },
        {
          "projects": ["holita-gateway"],
          "target": "graphql-generate"
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npm run build",
        "cwd": "holita/apps/sales"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["osnova-ui"],
          "target": "graphql-generate"
        },
        {
          "projects": ["holita-gateway"],
          "target": "graphql-generate"
        }
      ],
      "options": {
        "command": "npm run typecheck",
        "cwd": "holita/apps/sales"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "npm run dev",
        "cwd": "holita/apps/sales"
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "{workspaceRoot}/holita/packages/operator/**/*",
      "{workspaceRoot}/osnova/packages/ui/**/*",
      "{workspaceRoot}/holita/apps/commerce/src/**/*.graphql",
      "{workspaceRoot}/holita/apps/sales-api/src/**/*.graphql",
      "{workspaceRoot}/osnova/apps/core/src/**/*.graphql"
    ]
  }
}
