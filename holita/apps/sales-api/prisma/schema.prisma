generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  displayName         String?       @db.VarChar(255)
  websiteUrl          String?       @db.VarChar(2048)
  sourceName          String?       @db.VarChar(255)
  stage               LeadStage     @default(NEW)
  stageChangedAt      DateTime      @default(now()) @db.Timestamptz(3)
  wonAt               DateTime?     @db.Timestamptz(3)
  createdByUserId     String        @db.Uuid
  assignedAgentUserId String?       @db.Uuid
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  contacts            LeadContact[]
  notes               LeadNote[]
  tasks               LeadTask[]
  offers              SalesOffer[]
  appointmentBookings AppointmentBooking[]
  handoff             LeadHandoff?

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, assignedAgentUserId])
  @@map("lead")
}

enum LeadHandoffMode {
  NEW_MERCHANT @map("newMerchant")

  @@map("leadHandoffMode")
}

enum LeadHandoffState {
  PENDING   @map("pending")
  REJECTED  @map("rejected")
  COMPLETED @map("completed")

  @@map("leadHandoffState")
}

model LeadHandoff {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  leadId           String           @db.Uuid
  mode             LeadHandoffMode  @default(NEW_MERCHANT)
  state            LeadHandoffState @default(PENDING)
  initiatedByUserId String          @db.Uuid
  merchantName     String?          @db.VarChar(200)
  adminName        String?          @db.VarChar(200)
  adminEmail       String?          @db.VarChar(254)
  branchName       String?          @db.VarChar(200)
  merchantTenantId String?          @db.Uuid
  branchId         String?          @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  completedAt      DateTime?        @db.Timestamptz(3)
  lead             Lead             @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, leadId])
  @@map("leadHandoff")
}

enum LeadStage {
  NEW               @map("new")
  APPROVED_FOR_CALL @map("approvedForCall")
  CALLED            @map("called")
  INTERESTED        @map("interested")
  TRY_LATER         @map("tryLater")
  NOT_INTERESTED    @map("notInterested")
  WON               @map("won")
  LOST              @map("lost")

  @@map("leadStage")
}

enum LeadContactRole {
  OWNER     @map("owner")
  MANAGER   @map("manager")
  EMPLOYEE  @map("employee")
  TECHNICAL @map("technical")
  UNKNOWN   @map("unknown")

  @@map("leadContactRole")
}

model LeadContact {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  leadId    String          @db.Uuid
  name      String?         @db.VarChar(255)
  phone     String?         @db.VarChar(16)
  email     String?         @db.VarChar(255)
  role      LeadContactRole @default(UNKNOWN)
  isPrimary Boolean         @default(false)
  notes     String?         @db.Text
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  lead      Lead            @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, leadId], map: "leadContact_primary_key", where: raw("\"isPrimary\""))
  @@index([tenantId, leadId])
  @@map("leadContact")
}

model LeadNote {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  leadId       String   @db.Uuid
  occurredAt   DateTime @db.Timestamptz(3)
  text         String   @db.Text
  authorUserId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  lead         Lead     @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, leadId, occurredAt(sort: Desc), createdAt(sort: Desc), id], map: "leadNote_activity_idx")
  @@map("leadNote")
}

model LeadTask {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  leadId      String         @db.Uuid
  scheduledAt DateTime       @db.Timestamptz(3)
  type        LeadTaskType
  status      LeadTaskStatus @default(PENDING)
  note        String?        @db.Text
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  lead        Lead           @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, leadId, scheduledAt, id], map: "leadTask_schedule_idx")
  @@map("leadTask")
}

enum LeadTaskType {
  OUTREACH          @map("outreach")
  PREPARE_DEMO_SITE @map("prepareDemoSite")
  PREPARE_SEND_OFFER @map("prepareSendOffer")
  DEMO              @map("demo")
  RESEARCH          @map("research")

  @@map("leadTaskType")
}

enum LeadTaskStatus {
  PENDING     @map("pending")
  IN_PROGRESS @map("inProgress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")

  @@map("leadTaskStatus")
}

model SalesImportRecord {
  tenantId                String   @db.Uuid
  sourceSystem            String   @db.VarChar(32)
  entity                  String   @db.VarChar(16)
  sourceId                String   @db.Uuid
  targetId                String   @db.Uuid
  snapshotId              String   @db.VarChar(32)
  sourceFingerprint       String   @db.Char(64)
  targetFingerprint       String   @db.Char(64)
  importedAt              DateTime @default(now()) @db.Timestamptz(3)
  importedByCoreUserId    String   @db.Uuid
  leadCreatorProvenance   String?  @db.VarChar(32)

  @@id([tenantId, sourceSystem, entity, sourceId])
  @@map("salesImportRecord")
}

model SalesOffer {
  id                      String           @id @default(uuid()) @db.Uuid
  tenantId                String           @db.Uuid
  leadId                  String?          @db.Uuid
  authorUserId            String           @db.Uuid
  status                  SalesOfferStatus @default(DRAFT)
  preparedAt              DateTime?        @db.Timestamptz(3)
  manuallySentAt          DateTime?        @db.Timestamptz(3)
  recipientName           String?          @db.VarChar(255)
  recipientEmail          String?          @db.VarChar(254)
  replyEmail              String?          @db.VarChar(254)
  replyPhone              String?          @db.VarChar(255)
  currentSiteUrl          String?          @db.VarChar(2048)
  proposedSiteUrl         String?          @db.VarChar(2048)
  exampleDomain           String?          @db.VarChar(253)
  validUntil              DateTime?        @db.Date
  productCount            Int?
  categoryCount           Int?
  languages               String?          @db.VarChar(120)
  currentPlatform         String?          @db.VarChar(120)
  message                 String?          @db.Text
  includedScope           String?          @db.Text
  recommendedPlanName     String?          @db.VarChar(80)
  recommendedMonthlyPrice Decimal?        @db.Decimal(8, 2)
  alternativePlanName     String?          @db.VarChar(80)
  alternativeMonthlyPrice Decimal?        @db.Decimal(8, 2)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)
  lead                    Lead?            @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, authorUserId, updatedAt(sort: Desc), id])
  @@index([tenantId, leadId, authorUserId])
  @@map("salesOffer")
}

enum SalesOfferStatus {
  DRAFT         @map("draft")
  PREPARED      @map("prepared")
  MANUALLY_SENT @map("manuallySent")

  @@map("salesOfferStatus")
}

model AppointmentService {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  name            String                  @db.VarChar(255)
  description     String?                 @db.Text
  active          Boolean                 @default(true)
  color           AppointmentServiceColor
  durationMinutes Int
  bufferMinutes   Int
  weekdays        Int[]
  startMinute     Int
  endMinute       Int
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  bookings        AppointmentBooking[]

  @@unique([tenantId, id])
  @@index([tenantId, name, id])
  @@map("appointmentService")
}

enum AppointmentServiceColor {
  C1 @map("c1")
  C2 @map("c2")
  C3 @map("c3")
  C4 @map("c4")
  C5 @map("c5")
  C6 @map("c6")
  C7 @map("c7")
  C8 @map("c8")

  @@map("appointmentServiceColor")
}

model AppointmentBooking {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @db.Uuid
  serviceId       String                   @db.Uuid
  leadId          String?                  @db.Uuid
  status          AppointmentBookingStatus @default(CONFIRMED)
  notes           String?                  @db.Text
  startsAt        DateTime                 @db.Timestamptz(3)
  endsAt          DateTime                 @db.Timestamptz(3)
  blockedUntil    DateTime                 @db.Timestamptz(3)
  durationMinutes Int
  bufferMinutes   Int
  createdByUserId String                   @db.Uuid
  updatedByUserId String                   @db.Uuid
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  service         AppointmentService       @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  lead            Lead?                    @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, serviceId, startsAt])
  @@index([tenantId, leadId])
  @@map("appointmentBooking")
}

enum AppointmentBookingStatus {
  CONFIRMED @map("confirmed")
  CANCELLED @map("cancelled")
  COMPLETED @map("completed")
  NO_SHOW   @map("noShow")

  @@map("appointmentBookingStatus")
}
