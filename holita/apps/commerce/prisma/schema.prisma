  @@unique([tenantId, branchId, normalizedName])
  @@unique([tenantId, branchId, slug])
  @@map("productTag")
}

model ProductTagAssignment {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  tagId String @db.Uuid
  product Product @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Cascade)
