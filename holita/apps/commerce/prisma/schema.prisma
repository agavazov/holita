generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT @map("draft")
  ACTIVE @map("active")
  ARCHIVED @map("archived")
  @@map("productStatus")
}

enum BrandStatus {
  ACTIVE @map("active")
  HIDDEN @map("hidden")
  @@map("brandStatus")
}

model Brand {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  slug String @db.VarChar(200)
  logoKey String? @db.VarChar(41)
  status BrandStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  products Product[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, slug])
  @@unique([tenantId, branchId, logoKey])
  @@index([tenantId, branchId, name, id])
  @@map("brand")
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  slug String @db.VarChar(200)
  parentId String? @db.Uuid
  parent Category? @relation("CategoryTree", fields: [tenantId, branchId, parentId], references: [tenantId, branchId, id], onDelete: NoAction)
  children Category[] @relation("CategoryTree")
  sortOrder Int @default(0)
  active Boolean @default(true)
  products Product[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, slug])
  @@index([tenantId, branchId, parentId])
  @@map("category")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  brandId String? @db.Uuid
  brand Brand? @relation(fields: [tenantId, branchId, brandId], references: [tenantId, branchId, id], onDelete: NoAction)
  categoryId String? @db.Uuid
  category Category? @relation(fields: [tenantId, branchId, categoryId], references: [tenantId, branchId, id], onDelete: NoAction)
  name String @db.VarChar(200)
  price Decimal @db.Decimal(12, 2)
  status ProductStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, name, id])
  @@index([tenantId, branchId, brandId])
  @@index([tenantId, branchId, categoryId])
  @@map("product")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  email String @db.VarChar(254)
  name String @db.VarChar(200)
  passwordHash String? @db.VarChar(255)
  sessions ShopperSession[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, name, id])
  @@map("customer")
}

model ShopperSession {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  customerId String @db.Uuid
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([tenantId, branchId, customerId])
  @@map("shopperSession")
}
