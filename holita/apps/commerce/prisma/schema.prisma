generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT @map("draft")
  ACTIVE @map("active")
  ARCHIVED @map("archived")
  @@map("productStatus")
}

enum BrandStatus {
  ACTIVE @map("active")
  HIDDEN @map("hidden")
  @@map("brandStatus")
}

enum ProductCollectionMode {
  MANUAL @map("manual")
  CATEGORY @map("category")
  BRAND @map("brand")
  @@map("productCollectionMode")
}

enum ProductBadgeColor {
  ACCENT @map("accent")
  NEUTRAL @map("neutral")
  INFO @map("info")
  SUCCESS @map("success")
  WARN @map("warn")
  DANGER @map("danger")
  @@map("productBadgeColor")
}

enum OrderStatus {
  PLACED @map("placed")
  CONFIRMED @map("confirmed")
  PROCESSING @map("processing")
  SHIPPED @map("shipped")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
  @@map("orderStatus")
}

enum OrderPaymentStatus {
  UNPAID @map("unpaid")
  PAID @map("paid")
  @@map("orderPaymentStatus")
}

enum InvoicePaymentStatus {
  UNPAID @map("unpaid")
  PAID @map("paid")
  @@map("invoicePaymentStatus")
}

enum DiscountType {
  PERCENTAGE @map("percentage")
  FIXED @map("fixed")
  @@map("discountType")
}

enum BgnToEurAmountKind {
  VARIANT_PRICE @map("variantPrice")
  SHIPPING_FEE @map("shippingFee")
  FIXED_DISCOUNT @map("fixedDiscount")
  DISCOUNT_MIN_SUBTOTAL @map("discountMinSubtotal")
  @@map("bgnToEurAmountKind")
}

enum ShopPageStatus {
  DRAFT @map("draft")
  PUBLISHED @map("published")
  @@map("shopPageStatus")
}

enum BlogArticleStatus {
  DRAFT @map("draft")
  PUBLISHED @map("published")
  @@map("blogArticleStatus")
}

enum NavigationPlacement {
  HEADER @map("header")
  FOOTER @map("footer")
  @@map("navigationPlacement")
}

enum NavigationDestinationType {
  CATEGORY @map("category")
  COLLECTION @map("collection")
  PAGE @map("page")
  BLOG @map("blog")
  URL @map("url")
  @@map("navigationDestinationType")
}

model ShopSettings {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  displayName String? @db.VarChar(200)
  contactEmail String? @db.VarChar(254)
  contactPhone String? @db.VarChar(50)
  contactAddress String? @db.VarChar(500)
  logoKey String? @db.VarChar(41)
  faviconKey String? @db.VarChar(41)
  basicHome Json?
  @@id([tenantId, branchId])
  @@map("shopSettings")
}

model NavigationMenu {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  placement NavigationPlacement
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items NavigationMenuItem[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, placement])
  @@map("navigationMenu")
}

model NavigationMenuItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  menuId String @db.Uuid
  sortOrder Int
  labelBg String? @db.VarChar(200)
  labelEn String? @db.VarChar(200)
  destinationType NavigationDestinationType
  categoryId String? @db.Uuid
  collectionId String? @db.Uuid
  pageId String? @db.Uuid
  url String? @db.VarChar(2048)
  menu NavigationMenu @relation(fields: [tenantId, branchId, menuId], references: [tenantId, branchId, id], onDelete: Cascade)
  category Category? @relation(fields: [tenantId, branchId, categoryId], references: [tenantId, branchId, id], onDelete: Cascade)
  collection ProductCollection? @relation(fields: [tenantId, branchId, collectionId], references: [tenantId, branchId, id], onDelete: Cascade)
  page ShopPage? @relation(fields: [tenantId, branchId, pageId], references: [tenantId, branchId, id], onDelete: Cascade)
  @@unique([tenantId, branchId, menuId, sortOrder])
  @@index([tenantId, branchId, categoryId])
  @@index([tenantId, branchId, collectionId])
  @@index([tenantId, branchId, pageId])
  @@map("navigationMenuItem")
}

model ShopPage {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  slug String @db.VarChar(200)
  titleBg String? @db.VarChar(200)
  titleEn String? @db.VarChar(200)
  bodyBg String? @db.Text
  bodyEn String? @db.Text
  status ShopPageStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  navigationItems NavigationMenuItem[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, slug])
  @@index([tenantId, branchId, updatedAt(sort: Desc), id])
  @@map("shopPage")
}

model BlogArticle {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  slug String @db.VarChar(200)
  titleBg String? @db.VarChar(200)
  titleEn String? @db.VarChar(200)
  bodyBg String? @db.Text
  bodyEn String? @db.Text
  status BlogArticleStatus @default(DRAFT)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  tagAssignments BlogArticleTag[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, slug])
  @@index([tenantId, branchId, status, publishedAt(sort: Desc), id])
  @@map("blogArticle")
}

model BlogTag {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  normalizedName String @db.Text
  slug String @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  assignments BlogArticleTag[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, normalizedName])
  @@unique([tenantId, branchId, slug])
  @@map("blogTag")
}

model BlogArticleTag {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  articleId String @db.Uuid
  tagId String @db.Uuid
  article BlogArticle @relation(fields: [tenantId, branchId, articleId], references: [tenantId, branchId, id], onDelete: Cascade)
  tag BlogTag @relation(fields: [tenantId, branchId, tagId], references: [tenantId, branchId, id], onDelete: Restrict)
  @@id([tenantId, branchId, articleId, tagId])
  @@index([tenantId, branchId, tagId])
  @@map("blogArticleTag")
}

model Brand {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  slug String @db.VarChar(200)
  logoKey String? @db.VarChar(41)
  status BrandStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  products Product[]
  collections ProductCollection[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, slug])
  @@unique([tenantId, branchId, logoKey])
  @@index([tenantId, branchId, name, id])
  @@map("brand")
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  slug String @db.VarChar(200)
  parentId String? @db.Uuid
  parent Category? @relation("CategoryTree", fields: [tenantId, branchId, parentId], references: [tenantId, branchId, id], onDelete: NoAction)
  children Category[] @relation("CategoryTree")
  characteristicGroups CharacteristicGroupCategory[]
  sortOrder Int @default(0)
  active Boolean @default(true)
  products Product[]
  collections ProductCollection[]
  navigationItems NavigationMenuItem[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, slug])
  @@index([tenantId, branchId, parentId])
  @@map("category")
}

model Option {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  active Boolean @default(true)
  showInFilters Boolean @default(false)
  showInListing Boolean @default(false)
  values OptionValue[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, name])
  @@map("option")
}

model OptionValue {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  optionId String @db.Uuid
  option Option @relation(fields: [tenantId, branchId, optionId], references: [tenantId, branchId, id], onDelete: Cascade)
  label String @db.VarChar(200)
  swatchColor String? @db.VarChar(7)
  sortOrder Int
  variantLinks ProductVariantValue[]
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, optionId, sortOrder])
  @@map("optionValue")
}

enum CharacteristicKind {
  TEXT @map("text")
  SINGLE_CHOICE @map("singleChoice")
  MULTIPLE_CHOICE @map("multipleChoice")
  @@map("characteristicKind")
}

model CharacteristicGroup {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  sortOrder Int @default(0)
  active Boolean @default(true)
  characteristics Characteristic[]
  categories CharacteristicGroupCategory[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, sortOrder, id])
  @@map("characteristicGroup")
}

model CharacteristicGroupCategory {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  groupId String @db.Uuid
  categoryId String @db.Uuid
  group CharacteristicGroup @relation(fields: [tenantId, branchId, groupId], references: [tenantId, branchId, id], onDelete: Cascade)
  category Category @relation(fields: [tenantId, branchId, categoryId], references: [tenantId, branchId, id], onDelete: Restrict)
  @@id([tenantId, branchId, groupId, categoryId])
  @@index([tenantId, branchId, categoryId])
  @@map("characteristicGroupCategory")
}

model Characteristic {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  groupId String @db.Uuid
  group CharacteristicGroup @relation(fields: [tenantId, branchId, groupId], references: [tenantId, branchId, id], onDelete: Restrict)
  name String @db.VarChar(200)
  sortOrder Int @default(0)
  active Boolean @default(true)
  productValues ProductCharacteristicValue[]
  kind CharacteristicKind @default(TEXT)
  choices CharacteristicChoice[]
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, groupId, sortOrder, id])
  @@map("characteristic")
}

model CharacteristicChoice {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  characteristicId String @db.Uuid
  characteristic Characteristic @relation(fields: [tenantId, branchId, characteristicId], references: [tenantId, branchId, id], onDelete: Restrict)
  name String @db.VarChar(200)
  productAssignments ProductCharacteristicChoice[]
  @@unique([tenantId, branchId, characteristicId, id])
  @@map("characteristicChoice")
}

model ProductCharacteristicChoice {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  characteristicId String @db.Uuid
  choiceId String @db.Uuid
  product Product @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Cascade)
  choice CharacteristicChoice @relation(fields: [tenantId, branchId, characteristicId, choiceId], references: [tenantId, branchId, characteristicId, id], onDelete: Restrict)
  @@id([tenantId, branchId, productId, characteristicId, choiceId])
  @@index([tenantId, branchId, choiceId])
  @@map("productCharacteristicChoice")
}

model ProductCharacteristicValue {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  characteristicId String @db.Uuid
  product Product @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Cascade)
  characteristic Characteristic @relation(fields: [tenantId, branchId, characteristicId], references: [tenantId, branchId, id], onDelete: Restrict)
  value String @db.Text
  @@id([tenantId, branchId, productId, characteristicId])
  @@index([tenantId, branchId, characteristicId])
  @@map("productCharacteristicValue")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  brandId String? @db.Uuid
  brand Brand? @relation(fields: [tenantId, branchId, brandId], references: [tenantId, branchId, id], onDelete: NoAction)
  categoryId String? @db.Uuid
  category Category? @relation(fields: [tenantId, branchId, categoryId], references: [tenantId, branchId, id], onDelete: NoAction)
  name String @db.VarChar(200)
  descriptionBg String? @db.Text
  descriptionEn String? @db.Text
  variants ProductVariant[]
  images ProductImage[]
  collectionItems ProductCollectionItem[]
  characteristicValues ProductCharacteristicValue[]
  characteristicChoices ProductCharacteristicChoice[]
  badgeAssignments ProductBadgeAssignment[]
  tagAssignments ProductTagAssignment[]
  legacyPrice Decimal? @map("price") @db.Decimal(12, 2)
  status ProductStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, name, id])
  @@index([tenantId, branchId, brandId])
  @@index([tenantId, branchId, categoryId])
  @@map("product")
}

model ProductBadge {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  slug String @db.VarChar(200)
  active Boolean @default(true)
  color ProductBadgeColor @default(ACCENT)
  sortOrder Int @default(0)
  assignments ProductBadgeAssignment[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, slug])
  @@index([tenantId, branchId, sortOrder, name, id])
  @@map("productBadge")
}

model ProductBadgeAssignment {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  badgeId String @db.Uuid
  product Product @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Cascade)
  badge ProductBadge @relation(fields: [tenantId, branchId, badgeId], references: [tenantId, branchId, id], onDelete: Restrict)
  @@id([tenantId, branchId, productId, badgeId])
  @@index([tenantId, branchId, badgeId])
  @@map("productBadgeAssignment")
}

model ProductTag {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  normalizedName String @db.Text
  slug String @db.VarChar(200)
  assignments ProductTagAssignment[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, normalizedName])
  @@unique([tenantId, branchId, slug])
  @@map("productTag")
}

model ProductTagAssignment {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  tagId String @db.Uuid
  product Product @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Cascade)
  tag ProductTag @relation(fields: [tenantId, branchId, tagId], references: [tenantId, branchId, id], onDelete: Restrict)
  @@id([tenantId, branchId, productId, tagId])
  @@index([tenantId, branchId, tagId])
  @@map("productTagAssignment")
}

model ProductCollection {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(200)
  slug String @db.VarChar(200)
  active Boolean @default(true)
  mode ProductCollectionMode
  categoryId String? @db.Uuid
  category Category? @relation(fields: [tenantId, branchId, categoryId], references: [tenantId, branchId, id], onDelete: Restrict)
  brandId String? @db.Uuid
  brand Brand? @relation(fields: [tenantId, branchId, brandId], references: [tenantId, branchId, id], onDelete: Restrict)
  items ProductCollectionItem[]
  navigationItems NavigationMenuItem[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, slug])
  @@index([tenantId, branchId, categoryId])
  @@index([tenantId, branchId, brandId])
  @@map("productCollection")
}

model ProductCollectionItem {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  collectionId String @db.Uuid
  collection ProductCollection @relation(fields: [tenantId, branchId, collectionId], references: [tenantId, branchId, id], onDelete: Cascade)
  productId String @db.Uuid
  product Product @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Cascade)
  sortOrder Int
  @@id([tenantId, branchId, collectionId, productId])
  @@unique([tenantId, branchId, collectionId, sortOrder])
  @@index([tenantId, branchId, productId])
  @@map("productCollectionItem")
}

model ProductImage {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Cascade)
  storageKey String @db.VarChar(41)
  altText String? @db.Text
  sortOrder Int
  variants ProductVariant[]
  @@unique([tenantId, branchId, productId, id])
  @@unique([tenantId, branchId, storageKey])
  @@index([tenantId, branchId, productId, sortOrder, id])
  @@map("productImage")
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Cascade)
  imageId String? @db.Uuid
  image ProductImage? @relation(fields: [tenantId, branchId, productId, imageId], references: [tenantId, branchId, productId, id], onDelete: NoAction, map: "product_variant_gallery_image_fkey")
  sku String @db.VarChar(100)
  barcode String? @db.VarChar(255)
  price Decimal @db.Decimal(12, 2)
  weight Decimal? @db.Decimal(12, 3)
  width Decimal? @db.Decimal(12, 3)
  height Decimal? @db.Decimal(12, 3)
  depth Decimal? @db.Decimal(12, 3)
  quantity Int @default(0)
  minimumQuantity Int @default(1)
  inventoryTracked Boolean @default(false)
  active Boolean @default(true)
  combinationKey String @db.Char(64)
  sortOrder Int
  values ProductVariantValue[]
  cartLines CartLine[]
  orderLines OrderLine[]
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, sku])
  @@unique([tenantId, branchId, productId, combinationKey], map: "productVariant_product_combination_key")
  @@index([tenantId, branchId, productId, active, price])
  @@index([tenantId, branchId, productId, imageId])
  @@index([tenantId, branchId, inventoryTracked, quantity])
  @@map("productVariant")
}

model ProductVariantValue {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [tenantId, branchId, variantId], references: [tenantId, branchId, id], onDelete: Cascade)
  optionValueId String @db.Uuid
  optionValue OptionValue @relation(fields: [tenantId, branchId, optionValueId], references: [tenantId, branchId, id], onDelete: Restrict)
  @@id([tenantId, branchId, variantId, optionValueId])
  @@index([tenantId, branchId, optionValueId])
  @@map("productVariantValue")
}

// History survives replacement of variant rows during a product save.
model ProductVariantPriceHistory {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  variantId String @db.Uuid
  price Decimal @db.Decimal(12, 2)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  publicFrom DateTime? @db.Timestamptz(3)
  publicUntil DateTime? @db.Timestamptz(3)
  @@index([tenantId, branchId, variantId, recordedAt], map: "productVariantPriceHistory_variant_recordedAt_idx")
  @@map("productVariantPriceHistory")
}

enum CustomerAddressType {
  GENERAL @map("general")
  SHIPPING @map("shipping")
  BILLING @map("billing")
  @@map("customerAddressType")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  email String @db.VarChar(254)
  name String @db.VarChar(200)
  phone String? @db.VarChar(50)
  passwordHash String? @db.VarChar(255)
  passwordReset ShopperPasswordReset?
  sessions ShopperSession[]
  carts Cart[]
  orders Order[]
  addresses CustomerAddress[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, name, id])
  @@index([tenantId, branchId, createdAt])
  @@map("customer")
}

model CustomerAddress {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  customerId String @db.Uuid
  customer Customer @relation(fields: [tenantId, branchId, customerId], references: [tenantId, branchId, id], onDelete: Cascade)
  type CustomerAddressType @default(GENERAL)
  isDefault Boolean @default(false)
  recipient String @db.VarChar(200)
  line1 String @db.VarChar(200)
  line2 String? @db.VarChar(200)
  phone String? @db.VarChar(50)
  city String @db.VarChar(120)
  postalCode String @db.VarChar(20)
  countryCode String @db.Char(2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([tenantId, branchId, customerId, createdAt, id])
  @@unique([tenantId, branchId, customerId, type], map: "customerAddress_default_type_key", where: raw("\"isDefault\""))
  @@map("customerAddress")
}

model ShopperPasswordReset {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  customerId String @db.Uuid
  customer Customer @relation(fields: [tenantId, branchId, customerId], references: [tenantId, branchId, id], onDelete: Cascade)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  @@id([tenantId, branchId, customerId])
  @@map("shopperPasswordReset")
}

model ShopperSession {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  customerId String @db.Uuid
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([tenantId, branchId, customerId])
  @@map("shopperSession")
}

model Cart {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  customerId String? @db.Uuid
  customer Customer? @relation(fields: [tenantId, branchId, customerId], references: [tenantId, branchId, id], onDelete: Cascade)
  guestTokenHash String? @db.Char(64)
  discountId String? @db.Uuid
  discount Discount? @relation(fields: [tenantId, branchId, discountId], references: [tenantId, branchId, id], onDelete: Restrict)
  lines CartLine[]
  order Order?
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
