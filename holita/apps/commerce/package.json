{
  "name": "@holita/commerce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "nest start --watch --path tsconfig.dev.json",
    "start:prod": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "graphql:generate": "tsx ../../tools/graphql/commerce-generation.mts",
    "test:db": "node --experimental-vm-modules ../../../node_modules/jest/bin/jest.js --config jest.db.config.mjs --runInBand"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@apollo/subgraph": "2.14.4",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.1",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/graphql": "14.0.1",
    "@nestjs/platform-express": "12.0.4",
    "@osnova/auth": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "graphql": "16.14.2",
    "pg": "8.23.0",
    "playwright": "1.63.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "@nestjs/testing": "12.0.4"
  }
}
