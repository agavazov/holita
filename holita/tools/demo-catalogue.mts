type DemoVariant = readonly [sku: string, price: string, quantity: number, colour?: number];

type DemoProduct = readonly [
  id: number,
  name: string,
  price: string,
  status?: 'active' | 'draft' | 'archived',
  category?: number,
  variants?: readonly DemoVariant[],
  descriptions?: Readonly<{ bg: string; en: string }>,
];

type DemoCategory = readonly [
  id: number,
  name: string,
  slug: string,
  parent: number | null,
  sortOrder: number,
];

type DemoOption = readonly [
  id: number,
  name: string,
  values: readonly (readonly [id: number, label: string])[],
];

