{
  "name": "discocan",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "mysql2": "3.24.4",
    "nx": {
      "smol-toml": "1.9.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@apollo/federation-internals": {
      "uuid": "11.1.1"
    },
    "@apollo/query-graphs": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "npm run db:up && nx run edata-rules:build && nx run admin:graphql-generate && concurrently --kill-others --names gateway,core,fleet,admin,storybook --prefix-colors blue,green,cyan,red,yellow \"npm:dev:gateway\" \"npm:dev:core\" \"npm:dev:fleet\" \"npm run dev:admin --ignore-scripts\" \"npm run storybook --workspace @discocan/admin\"",
    "kill": "tsx tools/development/kill.mts",
    "erm:relay": "tsx tools/erm-relay/relay.mts",
    "erm:route-unit": "tsx tools/erm-relay/route-unit.mts",
    "dev:gateway": "npm run dev --workspace @discocan/gateway",
    "router:install": "npm run router:install --workspace @discocan/gateway",
    "dev:core": "npm run dev --workspace @discocan/core",
    "dev:erm-server": "npm run dev --workspace @discocan/erm-server",
    "dev:admin": "nx run edata-rules:build && npm run dev --workspace @discocan/admin",
    "storybook:admin": "nx run admin:storybook",
    "build": "nx run-many -t build",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:tools && nx run-many -t typecheck",
    "test:core": "nx run core:test --output-style=static",
    "test:admin": "nx run admin:test --output-style=static",
    "test:budget": "tsx tools/testing/test-budget.mts",
    "check": "nx affected -t build,test,test-db --output-style=static && eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "test:affected": "nx affected -t test,test-db,test-federation --skip-nx-cache --output-style=static",
    "test:full": "nx run-many -t test,test-db,test-federation --skip-nx-cache --output-style=static && npm run test:smoke:admin",
    "check:affected": "npm run lint:tools && npm run typecheck:tools && nx affected -t lint,typecheck,build",
    "lint:tools": "eslint tools *.mjs",
    "projects": "nx show projects",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:setup": "tsx tools/database/setup.mts",
    "db:test:setup": "tsx tools/database/setup.mts --test",
    "db:generate": "nx run-many -t db-generate --projects=core,fleet,erm-server",
    "db:validate": "npm run db:validate --workspace @discocan/core && npm run db:validate --workspace @discocan/fleet && npm run db:validate --workspace @discocan/erm-server",
    "db:migrate": "npm run db:migrate --workspace @discocan/core && npm run db:migrate --workspace @discocan/fleet && npm run db:migrate --workspace @discocan/erm-server",
    "db:seed": "npm run db:seed --workspace @discocan/core && npm run db:seed --workspace @discocan/fleet",
    "db:seed:fleet-demo": "tsx apps/fleet/prisma/demo/cli.ts",
    "db:seed:driver-scorecards": "tsx apps/fleet/prisma/demo/driver-scorecards-cli.ts",
    "test:core:db": "nx run core:test-db --skip-nx-cache --output-style=static",
    "prelint": "npm run db:generate && npm run codegen",
    "typecheck:tools": "tsc --project tools/tsconfig.json",
    "codegen": "nx run-many -t graphql-generate",
    "schema:compose": "npm run graphql:generate --workspace @discocan/gateway",
    "schema:check": "tsx tools/graphql/generate.mts check",
    "test:gateway:db": "nx run gateway:test-federation --output-style=static",
    "test:smoke": "npm run test:smoke:admin",
    "dev:fleet": "nx run edata-rules:build && npm run dev --workspace @discocan/fleet",
    "test:fleet": "nx run fleet:test --output-style=static",
    "test:fleet:db": "nx run fleet:test-db --skip-nx-cache --output-style=static",
    "test:smoke:admin": "nx run admin:test-smoke --output-style=static",
    "router:check": "npm run router:check --workspace @discocan/gateway"
  },
  "devDependencies": {
    "@apollo/composition": "2.14.4",
    "@apollo/subgraph": "2.14.4",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/core": "6.2.0",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.7",
    "@graphql-typed-document-node/core": "3.2.0",
    "@jest/globals": "30.5.2",
    "@nodable/entities": "3.1.0",
    "@nx/eslint-plugin": "23.2.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "angular-eslint": "22.5.0",
    "concurrently": "10.0.5",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "globals": "17.12.0",
    "graphql": "16.14.2",
    "jest": "30.5.2",
    "nx": "23.2.1",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
