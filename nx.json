{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "useDaemonProcess": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/jest.preset.mjs",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/.gitignore",
      "{workspaceRoot}/.nxignore",
      "{workspaceRoot}/.prettierignore",
      "{workspaceRoot}/.github/workflows/**/*",
      {
        "runtime": "node --version"
      }
    ],
    "databaseTooling": [
      "{workspaceRoot}/compose.yaml",
      "{workspaceRoot}/tools/database/**/*",
      "{workspaceRoot}/tools/tsconfig.json"
    ],
    "graphqlContracts": [
      "{workspaceRoot}/apps/core/src/**/*.graphql",
      "{workspaceRoot}/apps/products/src/**/*.graphql",
      "{workspaceRoot}/apps/reference/src/**/*.graphql",
      "{workspaceRoot}/apps/admin-react/src/**/*.graphql",
      "{workspaceRoot}/tools/graphql/**/*",
      "{workspaceRoot}/tools/tsconfig.json",
      "{workspaceRoot}/jest.schema.config.mjs",
      "{workspaceRoot}/jest.federation.config.mjs"
    ]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": ["default"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default"]
    },
    "build": {
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "cache": true,
      "inputs": ["default"]
    },
    "dev": {
      "cache": false,
      "continuous": true
    }
  },
  "analytics": true
}
