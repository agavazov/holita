{
  "name": "admin",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "discocan/apps/admin/src",
  "tags": ["product:discocan", "type:app", "scope:admin"],
  "implicitDependencies": ["gateway"],
  "targets": {
    "graphql-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["graphqlGeneration"],
      "outputs": ["{projectRoot}/src/generated/graphql"],
      "options": {
        "command": "npm run graphql:generate",
        "cwd": "discocan/apps/admin"
      }
    },
    "lint": {
      "dependsOn": ["graphql-generate"]
    },
    "typecheck": {
      "dependsOn": ["graphql-generate"]
    },
    "build": {
      "dependsOn": ["graphql-generate"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["graphql-generate"],
      "options": {
        "command": "npm run test --",
        "cwd": "discocan/apps/admin",
        "forwardAllArgs": true
      }
    },
    "test-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default"],
      "dependsOn": [
        {
          "target": "build",
          "projects": ["admin", "gateway", "core", "fleet", "erm-server"]
        }
      ],
      "options": {
        "command": "playwright test --config discocan/tools/browser/angular.config.mts",
        "cwd": ".",
        "forwardAllArgs": true
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "graphqlContracts",
      "{workspaceRoot}/discocan/tools/browser/**/*",
      "{workspaceRoot}/osnova/packages/ui/**/*"
    ]
  }
}
