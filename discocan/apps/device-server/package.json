    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "dotenv": "17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@types/node": "24.13.4"
  }
}
