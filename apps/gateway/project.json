{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/gateway/src",
  "implicitDependencies": ["core", "products"],
  "tags": ["type:app", "scope:gateway"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test --",
        "cwd": "apps/gateway",
        "forwardAllArgs": true
      },
      "dependsOn": ["graphql-generate"]
    },
    "graphql-generate": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "cache": true,
      "outputs": ["{projectRoot}/src/generated/graphql"],
      "options": {
        "command": "npm run graphql:generate",
        "cwd": "apps/gateway"
      }
    },
    "lint": {
      "dependsOn": ["graphql-generate"]
    },
    "typecheck": {
      "dependsOn": ["graphql-generate"]
    },
    "build": {
      "dependsOn": ["graphql-generate"]
    },
    "test-db": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["core", "products", "gateway"],
          "target": "build"
        }
      ],
      "options": {
        "command": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.federation.config.mjs --runInBand",
        "cwd": ".",
        "forwardAllArgs": true
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "graphqlContracts"]
  }
}
