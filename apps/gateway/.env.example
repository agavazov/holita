# Router reads exported process variables; it does not load this file automatically.
# Export these values in the shell that starts npm run dev. PORT is not used by Router.
# Gateway npm dev/start generate through Nx, then launch Router outside Nx's task environment.
ROUTER_PORT=11010
ROUTER_HEALTH_PORT=11016
CORE_GRAPHQL_URL=http://127.0.0.1:11011/graphql
FLEET_GRAPHQL_URL=http://127.0.0.1:11013/graphql
KARMA_CLIENT_GRAPHQL_URL=http://127.0.0.1:11014/graphql
ADMIN_ORIGIN=http://127.0.0.1:11000
