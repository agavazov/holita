PORT=11086
REFERENCE_ENABLED=true
CORE_GRAPHQL_URL=http://127.0.0.1:11082/graphql
REFERENCE_DATABASE_URL=postgresql://holita_reference:holita_reference_local@127.0.0.1:11084/holita_reference
