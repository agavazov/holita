{
  "name": "karma-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/karma-client/src",
  "tags": ["type:app", "scope:karma-client"],
  "targets": {
    "graphql-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/src/generated/graphql"],
      "options": {
        "command": "npm run graphql:generate",
        "cwd": "apps/karma-client"
      }
    },
    "lint": {
      "dependsOn": ["graphql-generate"]
    },
    "typecheck": {
      "dependsOn": ["graphql-generate"]
    },
    "build": {
      "dependsOn": ["graphql-generate"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["graphql-generate"],
      "options": {
        "command": "npm run test --",
        "cwd": "apps/karma-client",
        "forwardAllArgs": true
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "graphqlContracts"]
  }
}
