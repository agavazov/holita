{
  "name": "karma-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/karma-client/src",
  "tags": ["type:app", "scope:karma-client"],
  "targets": {
    "graphql-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["graphqlGeneration"],
      "outputs": ["{projectRoot}/src/generated/graphql"],
      "options": {
        "command": "npm run graphql:generate",
        "cwd": "apps/karma-client"
      }
    },
    "lint": {
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ]
    },
    "typecheck": {
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ]
    },
    "build": {
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ],
      "options": {
        "command": "npm run test --",
        "cwd": "apps/karma-client",
        "forwardAllArgs": true
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "graphqlContracts",
      "{workspaceRoot}/packages/edata-rules/src/**/*",
      "{workspaceRoot}/packages/edata-rules/tsconfig.json",
      "{workspaceRoot}/packages/edata-rules/package.json"
    ]
  }
}
