{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin/src",
  "tags": ["type:app", "scope:admin"],
  "implicitDependencies": ["gateway"],
  "targets": {
    "graphql-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["graphqlGeneration"],
      "outputs": ["{projectRoot}/src/generated/graphql"],
      "options": {
        "command": "npm run graphql:generate",
        "cwd": "apps/admin"
      }
    },
    "lint": {
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ]
    },
    "typecheck": {
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ]
    },
    "build": {
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ],
      "options": {
        "command": "npm run test --",
        "cwd": "apps/admin",
        "forwardAllArgs": true
      }
    },
    "storybook": {
      "dependsOn": [
        "graphql-generate",
        {
          "target": "build",
          "projects": ["edata-rules"]
        }
      ],
      "cache": false,
      "continuous": true
    },
    "test-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default"],
      "dependsOn": [
        {
          "target": "build",
          "projects": ["admin", "gateway", "core", "fleet", "karma-client", "erm-server"]
        }
      ],
      "options": {
        "command": "playwright test --config tools/browser/angular.config.mts",
        "cwd": ".",
        "forwardAllArgs": true
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "graphqlContracts",
      "{workspaceRoot}/tools/browser/**/*",
      "{workspaceRoot}/packages/edata-rules/src/**/*",
      "{workspaceRoot}/packages/edata-rules/tsconfig.json",
      "{workspaceRoot}/packages/edata-rules/package.json"
    ]
  }
}
