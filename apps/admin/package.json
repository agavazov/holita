{
  "name": "@holita/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --port 11000 --proxy-config proxy.conf.mjs",
    "predev": "npm run graphql:generate",
    "build": "ng build",
    "typecheck": "ngc --noEmit --project tsconfig.app.json && ngc --noEmit --project tsconfig.spec.json && ngc --noEmit --project .storybook/tsconfig.json",
    "lint": "eslint .",
    "test": "ng test --watch=false --progress=false",
    "storybook": "ng run admin:storybook",
    "build-storybook": "ng run admin:build-storybook",
    "test-storybook": "vitest run --config .storybook/vitest.config.mts",
    "graphql:generate": "tsx ../../tools/graphql/generate.mts admin"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@apollo/client": "4.3.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@primeicons/angular": "8.0.2",
    "@primeuix/themes": "3.0.1",
    "apollo-angular": "14.2.0",
    "graphql": "16.14.2",
    "primeng": "22.1.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@angular/animations": "22.2.1",
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/angular-vite": "10.6.1",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "jsdom": "30.0.1",
    "storybook": "10.6.1",
    "vitest": "5.0.0"
  }
}
