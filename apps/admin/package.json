{
  "name": "@holita/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --port 11000 --proxy-config proxy.conf.json",
    "predev": "npm run graphql:generate",
    "build": "ng build",
    "typecheck": "ngc --noEmit --project tsconfig.app.json && ngc --noEmit --project tsconfig.spec.json",
    "lint": "eslint .",
    "test": "ng test --watch=false --progress=false",
    "graphql:generate": "tsx ../../tools/graphql/generate.mts admin",
    "dev:mock": "ng serve --configuration prototype --host 127.0.0.1 --port 11001",
    "predev:mock": "npm run graphql:generate"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@apollo/client": "4.3.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@primeicons/angular": "8.0.2",
    "@primeuix/themes": "3.0.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "apollo-angular": "14.2.0",
    "dayjs": "1.11.23",
    "dompurify": "3.4.16",
    "graphql": "16.14.2",
    "msw": "3.0.1",
    "primeng": "22.1.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@types/validator": "13.15.10",
    "jsdom": "30.0.1",
    "vitest": "5.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
