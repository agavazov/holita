generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ErmDirection {
  DEVICE @map("device")
  UPSTREAM @map("upstream")
  DISCOCAN @map("discocan")
  @@map("ermDirection")
}

enum ErmCommandStatus {
  SENT @map("sent")
  ANSWERED @map("answered")
  TIMEOUT @map("timeout")
  FAILED @map("failed")
  @@map("ermCommandStatus")
}

enum ErmParameterSnapshotStatus {
  RUNNING @map("running")
  COMPLETE @map("complete")
  FAILED @map("failed")
  @@map("ermParameterSnapshotStatus")
}

enum ErmParameterReadOutcome {
  READ @map("read")
  REJECTED @map("rejected")
  OMITTED @map("omitted")
  @@map("ermParameterReadOutcome")
}

enum ErmConfigurationOperation {
  READ_EDATA @map("readEdata")
  INTERVAL @map("interval")
  ADD_DEFINITION @map("addDefinition")
  GLOBALS @map("globals")
  PARAMETER @map("parameter")
  PARAMETERS @map("parameters")
  @@map("ermConfigurationOperation")
}

enum ErmConfigurationChangeStatus {
  RUNNING @map("running")
  READ @map("read")
  VERIFIED @map("verified")
  MISMATCH @map("mismatch")
  RESTORED @map("restored")
  RESTORE_FAILED @map("restoreFailed")
  UNCERTAIN @map("uncertain")
  REFUSED @map("refused")
  FAILED @map("failed")
  @@map("ermConfigurationChangeStatus")
}

enum ErmDeviceAction {
  REQUEST_LOCATION @map("requestLocation")
  READ_STATUS @map("readStatus")
  READ_VERSION @map("readVersion")
  READ_ACCESSORIES @map("readAccessories")
  READ_EDATA_DIAGNOSTICS @map("readEdataDiagnostics")
  READ_EDATA_FAULTS @map("readEdataFaults")
  READ_PARAMETERS @map("readParameters")
  @@map("ermDeviceAction")
}

enum ErmCommandRequestStatus {
  QUEUED @map("queued")
  SUBMITTING @map("submitting")
  ANSWERED @map("answered")
  FAILED @map("failed")
  EXPIRED @map("expired")
  CANCELLED @map("cancelled")
  UNCERTAIN @map("uncertain")
  @@map("ermCommandRequestStatus")
}

enum ErmChecksum {
  OK @map("ok")
  MISMATCH @map("mismatch")
  ABSENT @map("absent")
  @@map("ermChecksum")
}

enum ErmRecoveryOutcome {
  ALREADY_DISCOCAN @map("alreadyDiscoCan")
  NEEDS_OPERATOR @map("needsOperator")
  @@map("ermRecoveryOutcome")
}

model ErmRecoverySession {
  id String @id @default(uuid()) @db.Uuid
  unitId String? @db.VarChar(15)
  peer String
  startedAt DateTime @db.Timestamptz(3)
  finishedAt DateTime @db.Timestamptz(3)
  outcome ErmRecoveryOutcome
  reason String
  primaryHost String?
  primaryPort String?
  karmaReturns ErmKarmaReturnAttempt[]
  @@index([unitId, startedAt(sort: Desc)])
  @@map("ermRecoverySession")
}

model ErmConnection {
  id String @id @default(uuid()) @db.Uuid
  peer String
  unitId String? @db.VarChar(15)
  upstream String
  openedAt DateTime @default(now()) @db.Timestamptz(3)
  forwardedAt DateTime? @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  closeReason String?
  deviceBytes BigInt @default(0)
  serverBytes BigInt @default(0)
  frames ErmFrame[]
  commands ErmCommand[]
  upstreamCloses ErmUpstreamClose[]
  karmaReturns ErmKarmaReturnAttempt[]
  @@map("ermConnection")
}

model ErmUpstreamClose {
  id BigInt @id @default(autoincrement())
  connectionId String @db.Uuid
  connection ErmConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  closedAt DateTime @db.Timestamptz(3)
  reason String
  @@index([connectionId, closedAt(sort: Desc)])
  @@map("ermUpstreamClose")
}

model ErmFrame {
  id BigInt @id @default(autoincrement())
  connectionId String @db.Uuid
  connection ErmConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receivedAt DateTime @db.Timestamptz(3)
  direction ErmDirection
  unitId String? @db.VarChar(15)
  command String? @db.VarChar(3)
  reference String? @db.VarChar(9)
  checksum ErmChecksum
  partial Boolean @default(false)
  raw Bytes
  events ErmEvent[]
  @@index([unitId, receivedAt(sort: Desc)])
  @@map("ermFrame")
}

model ErmCommand {
  id String @id @default(uuid()) @db.Uuid
  unitId String @db.VarChar(15)
  connectionId String @db.Uuid
  connection ErmConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reference String @db.VarChar(9)
  command String @db.VarChar(3)
  fields String[]
  status ErmCommandStatus @default(SENT)
  sentAt DateTime @db.Timestamptz(3)
  answeredAt DateTime? @db.Timestamptz(3)
  resultCode String?
  response Bytes?
  @@index([unitId, sentAt(sort: Desc)])
  @@map("ermCommand")
}

model ErmEvent {
  id BigInt @id @default(autoincrement())
  frameId BigInt
  frame ErmFrame @relation(fields: [frameId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unitId String @db.VarChar(15)
  reference String? @db.VarChar(10)
  eventId String? @db.VarChar(3)
  eventTime DateTime? @db.Timestamptz(3)
  positionTime DateTime? @db.Timestamptz(3)
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  speedKmh Float?
  heading Float?
  odometer Float?
  engineOn Boolean?
  mainVoltage Float?
  backupVoltage Float?
  fields Json
  @@index([unitId, eventTime(sort: Desc)])
  @@map("ermEvent")
}

model ErmParameterSnapshot {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  branchId String? @db.Uuid
  deviceId String? @db.Uuid
  actorId String? @db.VarChar(128)
  intent String? @db.VarChar(200)
  unitId String @db.VarChar(15)
  status ErmParameterSnapshotStatus @default(RUNNING)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  parameterCount Int
  readCount Int @default(0)
  failureReason String?
  values ErmParameterValue[]
  @@index([unitId, startedAt(sort: Desc)])
  @@index([tenantId, branchId, deviceId, startedAt(sort: Desc)])
  @@map("ermParameterSnapshot")
}

model ErmParameterValue {
  snapshotId String @db.Uuid
  snapshot ErmParameterSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parameter Int
  value String?
  resultCode String?
  outcome ErmParameterReadOutcome @default(OMITTED)
  @@id([snapshotId, parameter])
  @@map("ermParameterValue")
}

model ErmConfigurationChange {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  branchId String? @db.Uuid
  deviceId String? @db.Uuid
  actorId String? @db.VarChar(128)
  intent String? @db.VarChar(200)
  unitId String @db.VarChar(15)
  parameter Int?
  operation ErmConfigurationOperation
  parameters Int[] @default([])
  batchId String? @db.Uuid
  batchIndex Int?
  batch ErmCommandBatch? @relation(fields: [tenantId, branchId, batchId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  status ErmConfigurationChangeStatus
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  failureReason String?
  baseline Json
  intended String?
  steps Json
  @@index([unitId, startedAt(sort: Desc)])
  @@index([tenantId, branchId, deviceId, startedAt(sort: Desc)])
  @@unique([batchId, batchIndex])
  @@map("ermConfigurationChange")
}

model ErmCommandRequest {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  deviceId String @db.Uuid
  unitId String @db.VarChar(15)
  actorId String @db.VarChar(128)
  intent String @db.VarChar(200)
  action ErmDeviceAction
  // Tracker parameters of a READ_PARAMETERS request; empty for the fixed reads.
  parameters Int[] @default([])
  status ErmCommandRequestStatus @default(QUEUED)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  submittedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  commandId String? @db.Uuid
  resultCode String?
  responseText String?
  failureReason String?
  cancelledByActorId String? @db.VarChar(128)
  waitingReason String? @db.VarChar(64)
  waitingSince DateTime? @db.Timestamptz(3)
  retryOfId String? @db.Uuid
  retryOf ErmCommandRequest? @relation("CommandRetries", fields: [tenantId, branchId, retryOfId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  retries ErmCommandRequest[] @relation("CommandRetries")
  batchId String? @db.Uuid
  batchIndex Int?
  batch ErmCommandBatch? @relation(fields: [tenantId, branchId, batchId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([tenantId, branchId, id])
  @@unique([batchId, batchIndex])
  @@index([tenantId, branchId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt])
  @@index([tenantId, branchId, deviceId, createdAt(sort: Desc)])
  @@map("ermCommandRequest")
}

model ErmCommandBatch {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  actorId String @db.VarChar(128)
  action ErmDeviceAction?
  configurationChanges ErmConfigurationChange[]
  finishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @db.Timestamptz(3)
  stoppedAt DateTime? @db.Timestamptz(3)
  stoppedByActorId String? @db.VarChar(128)
  requests ErmCommandRequest[]
  @@unique([tenantId, branchId, id])
  @@map("ermCommandBatch")
}

enum ErmKarmaRoutingState {
  UNKNOWN @map("unknown")
  DISCOCAN @map("discocan")
  KARMA_BACKUP @map("karmaBackup")
  @@map("ermKarmaRoutingState")
}

enum ErmKarmaReturnStatus {
  SUBMITTING @map("submitting")
  QUEUED @map("queued")
  UNCERTAIN @map("uncertain")
  RETURNED @map("returned")
  NEEDS_OPERATOR @map("needsOperator")
  FAILED @map("failed")
  @@map("ermKarmaReturnStatus")
}

model ErmKarmaRouting {
  id BigInt @id @default(autoincrement())
  unitId String @db.VarChar(15)
  state ErmKarmaRoutingState
  since DateTime? @db.Timestamptz(3)
  observedAt DateTime @db.Timestamptz(3)
  latestKarmaReportAt DateTime? @db.Timestamptz(3)
  parked Boolean?
  createdAt DateTime @db.Timestamptz(3)
  notificationKind String? @db.VarChar(64)
  @@index([unitId, id(sort: Desc)])
  @@map("ermKarmaRouting")
}

model ErmKarmaReturnAttempt {
  id String @id @default(uuid()) @db.Uuid
  // Null together for automatic returns, which belong to the unit rather than an operator's Branch.
  tenantId String? @db.Uuid
  branchId String? @db.Uuid
  deviceId String? @db.Uuid
  unitId String @db.VarChar(15)
  actorId String @db.VarChar(128)
  requestedAt DateTime @db.Timestamptz(3)
  queueId String?
  status ErmKarmaReturnStatus @default(SUBMITTING)
  pending Boolean @default(true)
  recoverySessionId String? @db.Uuid
  recovery ErmRecoverySession? @relation(fields: [recoverySessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  discocanConnectionId String? @db.Uuid
  discocanConnection ErmConnection? @relation(fields: [discocanConnectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([tenantId, branchId, deviceId, requestedAt(sort: Desc)])
  @@index([unitId, requestedAt(sort: Desc)])
  @@map("ermKarmaReturnAttempt")
}
