generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum FleetDistanceUnit {
  KM
  MI
}

enum FleetVolumeUnit {
  LITRE
  US_GALLON
}

model FleetSettings {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  branchId          String            @db.Uuid
  timeZone          String            @default("Europe/Sofia") @db.VarChar(64)
  distanceUnit      FleetDistanceUnit @default(KM)
  volumeUnit        FleetVolumeUnit   @default(LITRE)
  lowFuelPct        Int               @default(12)
  notReportingHours Int               @default(48)
  speedLimitKph     Int               @default(90)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, branchId])
}

enum FleetVehicleType {
  TRACTOR
  RIGID_TRUCK
  VAN
  CAR
  TRAILER
  OTHER
}

enum FleetFuelType {
  DIESEL
  PETROL
  LPG
  CNG
  ELECTRIC
  HYBRID
}

enum FleetVehicleStatus {
  ACTIVE
  IN_WORKSHOP
  INACTIVE
}

enum FleetDeviceModel {
  STARLINK_TRACKER
  STARLINK_SCOUT
  OTHER
}

enum FleetDeviceOperationStatus {
  QUEUED
  SUBMITTING
  WAITING
  COMPLETE
  TIMED_OUT
  FAILED
  UNKNOWN
}

enum FleetDeviceOption {
  CELLULAR_4G
  SAFETY_SF
  IRF
  CAN
  DRIVER_ID
  GEOZONES_GO
  TEMPERATURE_DS
  ECONNECT
  WIFI
  VOICE
  EXTERNAL_ANTENNA
  RS232
  WILIOT
}

enum FleetDriverStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum FleetLicenseCategory {
  B
  BE
  C1
  C1E
  C
  CE
  D1
  D1E
  D
  DE
}

// Design-system categorical slot, never a colour value.
enum FleetGroupColor {
  C1
  C2
  C3
  C4
  C5
  C6
  C7
  C8
}

// DEMO rows come from devices (or the demo seed); MANUAL rows are operator odometer readings.
enum FleetDataSource {
  DEMO
  MANUAL
}

// The first nine values are the maneuver kinds used by scores and scorecards.
enum FleetEventKind {
  HARSH_ACCELERATION
  HARSH_BRAKING
  SPEED_BUMP
  OVERTAKING
  ROUNDABOUT
  LANE_CHANGE
  SHARP_TURN
  OFF_ROAD
  SPEEDING
  IGNITION_ON
  IGNITION_OFF
  IDLING
  LOW_FUEL
  FUEL_DROP
  POWER_DISCONNECTED
  LOW_BACKUP_BATTERY
  CAN_DISCONNECTED
  DEVICE_OFFLINE
  DIAGNOSTIC_TROUBLE_CODE
  CRASH_DETECTED
}

enum FleetEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum FleetAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum FleetServiceType {
  GENERAL_SERVICE
  OIL_CHANGE
  ANNUAL_INSPECTION
  TACHOGRAPH_CALIBRATION
  BRAKES
  TIRES
  REPAIR
  OTHER
}

enum FleetServiceStatus {
  PLANNED
  DONE
  CANCELLED
}

// Columns after notes are appended by the fleet_master_data migration (ADD COLUMN).
// Hand-written CHECKs in that migration: modelYear, vin, fuelTankCapacityL, INACTIVE without driver.
model Vehicle {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  licensePlate String @db.VarChar(32)
  notes String? @db.VarChar(2000)
  fleetNumber String? @db.VarChar(16)
  vehicleType FleetVehicleType?
  make String? @db.VarChar(64)
  model String? @db.VarChar(64)
  modelYear Int? @db.SmallInt
  vin String? @db.VarChar(17)
  fuelType FleetFuelType?
  fuelTankCapacityL Int? @db.SmallInt
  status FleetVehicleStatus @default(ACTIVE)
  groupId String? @db.Uuid
  currentDriverId String? @db.Uuid
  group VehicleGroup? @relation(fields: [tenantId, branchId, groupId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  currentDriver Driver? @relation(fields: [tenantId, branchId, currentDriverId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  devices Device[]
  statusSamples VehicleStatusSample[]
  trips Trip[]
  events FleetEvent[]
  serviceTasks ServiceTask[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, fleetNumber])
  @@unique([tenantId, branchId, vin])
  @@index([tenantId, branchId, createdAt, id])
  @@index([tenantId, branchId, groupId])
  @@index([tenantId, branchId, currentDriverId])
}

// Hand-written CHECKs: options NOT NULL with at most 13 values, SIM phone number and ICCID formats.
model Device {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  imei String @db.VarChar(15)
  vehicleId String? @db.Uuid
  vehicle Vehicle? @relation(fields: [tenantId, branchId, vehicleId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  model FleetDeviceModel?
  options FleetDeviceOption[] @default([])
  firmwareVersion String? @db.VarChar(32)
  simPhoneNumber String? @db.VarChar(20)
  simIccid String? @db.VarChar(22)
  installedAt DateTime? @db.Timestamptz(3)
  notes String? @db.VarChar(2000)
  operations FleetDeviceOperation[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, imei])
  @@index([tenantId, branchId, createdAt, id])
  @@index([tenantId, branchId, vehicleId])
}

enum FleetDeviceOperationKind {
  READ_CONFIGURATION
  ADD_PARAMETER
  UPDATE_INTERVAL
}

enum FleetDeviceOperationPhase {
  READ_PROFILE
  READ_PARAMETERS
  WRITE_PARAMETER
  VERIFY_PARAMETERS
}

// Configuration operations retain intent, preflight evidence and independent readback.
model FleetDeviceOperation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  deviceId String @db.Uuid
  device Device @relation(fields: [tenantId, branchId, deviceId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  deviceImei String @db.VarChar(15)
  karmaCarId String @db.VarChar(32)
  karmaDeviceId String @db.VarChar(128)
  status FleetDeviceOperationStatus @default(QUEUED)
  kind FleetDeviceOperationKind @default(READ_CONFIGURATION)
  phase FleetDeviceOperationPhase @default(READ_PARAMETERS)
  baselineOperationId String? @db.Uuid
  baselineOperation FleetDeviceOperation? @relation("DeviceOperationBaseline", fields: [tenantId, branchId, baselineOperationId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict, map: "FleetDeviceOperation_baseline_scope_fkey")
  dependentOperations FleetDeviceOperation[] @relation("DeviceOperationBaseline")
  parameterId Int?
  intervalSeconds Int?
  previousIntervalSeconds Int?
  catalogId String? @db.Uuid
  profileId Int?
  profileReadAt DateTime? @db.Timestamptz(3)
  profileObservations Json @default("[]")
  baselineConfiguration Json?
  baselineConfigurationId String? @db.VarChar(16)
  baselineObservations Json @default("[]")
  baselineReadAt DateTime? @db.Timestamptz(3)
  definitionHex String? @db.VarChar(44)
  readAfterMessageId String? @db.VarChar(16)
  phaseDispatchedAt DateTime? @db.Timestamptz(3)
  writeDispatchedAt DateTime? @db.Timestamptz(3)
  writeQueueIds String[] @default([])
  writeUncertain Boolean @default(false)
  requestedAt DateTime @default(now()) @db.Timestamptz(3)
  dispatchedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  nextCheckAt DateTime @db.Timestamptz(3)
  deadlineAt DateTime @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(3)
  queueIds String[] @default([])
  observations Json @default("[]")
  configuration Json?
  configurationId String? @db.VarChar(16)
  errorCode String? @db.VarChar(64)
  attempts Int @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, deviceId, requestedAt, id])
  @@index([status, nextCheckAt, leaseUntil])
}

// Hand-written CHECKs: licenseCategories NOT NULL with at most 10 values, phone format.
model Driver {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  firstName String @db.VarChar(64)
  lastName String @db.VarChar(64)
  employeeNumber String? @db.VarChar(32)
  identificationKey String? @db.VarChar(32)
  phone String? @db.VarChar(20)
  email String? @db.VarChar(254)
  licenseNumber String? @db.VarChar(32)
  licenseCategories FleetLicenseCategory[] @default([])
  licenseExpiresOn DateTime? @db.Date
  tachographCardNumber String? @db.VarChar(16)
  tachographCardExpiresOn DateTime? @db.Date
  status FleetDriverStatus @default(ACTIVE)
  notes String? @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  vehicles Vehicle[]
  trips Trip[]
  events FleetEvent[]

  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, employeeNumber])
  @@unique([tenantId, branchId, identificationKey])
  @@index([tenantId, branchId, lastName, firstName, id])
  @@index([tenantId, branchId, createdAt, id])
}

model VehicleGroup {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(64)
  description String? @db.VarChar(500)
  colorToken FleetGroupColor @default(C1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  vehicles Vehicle[]

  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, createdAt, id])
}

// Activity rows keep the reporting IMEI as a snapshot (no Device FK), so devices can be replaced
// or deleted without rewriting history. Hand-written CHECKs in the fleet_activity migration:
// MANUAL rows are exactly the null-IMEI odometer readings, IMEI format, coordinates, ranges.
model VehicleStatusSample {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  vehicleId String @db.Uuid
  deviceImei String? @db.VarChar(15)
  source FleetDataSource
  recordedAt DateTime @db.Timestamptz(3)
  receivedAt DateTime @db.Timestamptz(3)
  latitude Float?
  longitude Float?
  address String? @db.VarChar(256)
  speedKph Float?
  headingDeg Int? @db.SmallInt
  ignition Boolean?
  odometerKm Float?
  fuelLevelPct Float?
  externalVoltage Float?
  backupBatteryVoltage Float?
  engineHours Float?
  coolantTempC Int? @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  vehicle Vehicle @relation(fields: [tenantId, branchId, vehicleId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, branchId, vehicleId, deviceImei, recordedAt])
  @@index([tenantId, branchId, vehicleId, recordedAt(sort: Desc)])
  @@index([tenantId, branchId, recordedAt])
}

// Hand-written CHECKs: never MANUAL, IMEI format, end not before start, coordinates, ranges.
model Trip {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  vehicleId String @db.Uuid
  driverId String? @db.Uuid
  deviceImei String? @db.VarChar(15)
  source FleetDataSource
  startedAt DateTime @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  startAddress String? @db.VarChar(256)
  endAddress String? @db.VarChar(256)
  startLatitude Float?
  startLongitude Float?
  endLatitude Float?
  endLongitude Float?
  startOdometerKm Float?
  endOdometerKm Float?
  distanceKm Float?
  idleSeconds Int?
  maxSpeedKph Float?
  fuelUsedL Float?
  drivingScore Float?
  ecoScore Float?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  vehicle Vehicle @relation(fields: [tenantId, branchId, vehicleId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  driver Driver? @relation(fields: [tenantId, branchId, driverId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  events FleetEvent[]

  @@unique([tenantId, branchId, vehicleId, id])
  @@index([tenantId, branchId, startedAt(sort: Desc), id])
  @@index([tenantId, branchId, vehicleId, startedAt])
  @@index([tenantId, branchId, driverId, startedAt])
}

// The trip relation includes vehicleId, so an event's vehicle always equals its trip's vehicle.
// Hand-written CHECKs: never MANUAL, IMEI format, coordinates, intensity only on maneuvers,
// the alert state machine with its timestamps, and no alert status on INFO events.
model FleetEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  vehicleId String @db.Uuid
  tripId String? @db.Uuid
  driverId String? @db.Uuid
  deviceImei String? @db.VarChar(15)
  source FleetDataSource
  occurredAt DateTime @db.Timestamptz(3)
  kind FleetEventKind
  severity FleetEventSeverity
  intensity Int? @db.SmallInt
  latitude Float?
  longitude Float?
  address String? @db.VarChar(256)
  speedKph Float?
  measuredValue Float?
  thresholdValue Float?
  troubleCode String? @db.VarChar(32)
  details String? @db.VarChar(500)
  alertStatus FleetAlertStatus?
  acknowledgedAt DateTime? @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  remark String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  vehicle Vehicle @relation(fields: [tenantId, branchId, vehicleId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  trip Trip? @relation(fields: [tenantId, branchId, vehicleId, tripId], references: [tenantId, branchId, vehicleId, id], onDelete: Restrict, onUpdate: Restrict)
  driver Driver? @relation(fields: [tenantId, branchId, driverId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, branchId, occurredAt(sort: Desc), id])
  @@index([tenantId, branchId, alertStatus, occurredAt(sort: Desc), id])
  @@index([tenantId, branchId, vehicleId, occurredAt])
  @@index([tenantId, branchId, vehicleId, tripId])
  @@index([tenantId, branchId, driverId, occurredAt])
}

// Costs are integer EUR cents. Hand-written CHECKs: the PLANNED/DONE/CANCELLED field rules and
// value ranges.
model ServiceTask {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  vehicleId String @db.Uuid
  serviceType FleetServiceType
  status FleetServiceStatus @default(PLANNED)
  title String? @db.VarChar(120)
  dueOn DateTime? @db.Date
  dueOdometerKm Int?
  completedOn DateTime? @db.Date
  completedOdometerKm Int?
  workshop String? @db.VarChar(128)
  replacedParts String? @db.VarChar(1000)
  costCents Int?
  notes String? @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  vehicle Vehicle @relation(fields: [tenantId, branchId, vehicleId], references: [tenantId, branchId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, branchId, status, dueOn, id])
  @@index([tenantId, branchId, vehicleId, status])
  @@index([tenantId, branchId, completedOn])
}

// Shared vendor reference data. Device/Vehicle data remains Tenant/Branch scoped.
model EdataCatalog {
  id String @id @default(uuid()) @db.Uuid
  sourceSha256 String @db.Char(64)
  extractorVersion String @db.VarChar(32)
  schemaVersion Int
  packageLabel String @db.VarChar(64)
  contentSha256 String @db.Char(64)
  metadata Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sources EdataCatalogSource[]
  sets EdataCatalogSet[]
  categories EdataCatalogCategory[]

  @@unique([sourceSha256, extractorVersion, schemaVersion])
}

model EdataCatalogSource {
  catalogId String @db.Uuid
  key String
  kind String @db.VarChar(16)
  evidence Json
  catalog EdataCatalog @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  parameters EdataCatalogParameter[]

  @@id([catalogId, key])
}

model EdataCatalogParameter {
  catalogId String @db.Uuid
  key String
  sourceKey String
  parameterId Int
  category String
  name String
  multiply String?
  offset String?
  details Json
  source EdataCatalogSource @relation(fields: [catalogId, sourceKey], references: [catalogId, key], onDelete: Restrict)

  @@id([catalogId, key])
  @@index([catalogId, parameterId, category])
}

model EdataCatalogSet {
  catalogId String @db.Uuid
  vendorId Int
  details Json
  catalog EdataCatalog @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  members EdataCatalogSetMember[]
  profiles EdataCatalogProfile[]

  @@id([catalogId, vendorId])
}

model EdataCatalogSetMember {
  catalogId String @db.Uuid
  setId Int
  position Int
  parameterId Int
  set EdataCatalogSet @relation(fields: [catalogId, setId], references: [catalogId, vendorId], onDelete: Restrict)

  @@id([catalogId, setId, position])
  @@index([catalogId, parameterId])
}

model EdataCatalogCategory {
  catalogId String @db.Uuid
  vendorId Int
  name String
  catalog EdataCatalog @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  profiles EdataCatalogProfile[]

  @@id([catalogId, vendorId])
}

model EdataCatalogProfile {
  catalogId String @db.Uuid
  vendorId Int
  setId Int
  categoryId Int
  name String
  set EdataCatalogSet @relation(fields: [catalogId, setId], references: [catalogId, vendorId], onDelete: Restrict)
  category EdataCatalogCategory @relation(fields: [catalogId, categoryId], references: [catalogId, vendorId], onDelete: Restrict)

  @@id([catalogId, vendorId])
}
