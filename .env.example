# discocan environment reference, using @env-spec style annotations.
# This is the only environment example/schema in the repository.
# Copy the relevant variables into the ignored root or application .env described
# below; export Router/proxy variables in the shell that launches npm.
# dotenv and Compose treat decorators as comments; no schema validator is installed.
# Safe local development defaults are shown. Keep existing installation secrets.
# Store real credentials in the shared services/.credentials or project-local
# .credentials directory documented in AGENTS.local.md. Supply them through the
# consuming process environment or its ignored runtime .env.
# See docs/development.md#ports-and-environment for consumers and precedence.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# PostgreSQL host port. Root .env: Compose and database provisioning.
# Keep all database URLs below aligned with this port.
# @public @type=port(min=1, max=65535)
POSTGRES_PORT=11084

# PostgreSQL data volume. Root .env: Compose. Use an existing copied volume only
# after preserving the original and migrating its database names and roles.
# @public @type=string(minLength=1)
POSTGRES_VOLUME=discocan_postgres_data

# PostgreSQL provisioning password. Root .env: Compose and database provisioning.
# Development-only default; preserve the password of an initialized database.
# @sensitive @type=string(minLength=1)
POSTGRES_PASSWORD=discocan_admin_local

# Core .env: Prisma, Core runtime and root database provisioning.
# Application database credentials are separate from the provisioning role.
# @sensitive @type=url
CORE_DATABASE_URL=postgresql://discocan_core:discocan_core_local@127.0.0.1:11084/discocan_core

# Core .env: guarded database tests and root test-database provisioning.
# Tests require the dedicated test role/database, never the development URL.
# @sensitive @type=url
CORE_TEST_DATABASE_URL=postgresql://discocan_core_test:discocan_core_test_local@127.0.0.1:11084/discocan_core_test

# Core, Fleet and ERM Server api/all .env: authenticates POST /internal/auth/verify.
# Configure the same private value in all three services for user sessions.
# Unset/short values leave this endpoint unavailable; there is no default secret.
# @sensitive @type=string(minLength=32)
CORE_INTERNAL_AUTH_TOKEN=

# Fleet and ERM Server api/all .env: Core's full internal session verification URL.
# Defaults to http://127.0.0.1:11011/internal/auth/verify when omitted.
# @public @type=url
CORE_AUTH_VERIFY_URL=

# Core user:create setup command only: password alternative to stdin.
# Supply transiently from a secret source, never as a command-line argument.
# @sensitive @type=string(minLength=12, maxLength=128)
CORE_SETUP_PASSWORD=

# Fleet .env: Prisma, Fleet runtime and root database provisioning.
# @sensitive @type=url
FLEET_DATABASE_URL=postgresql://discocan_fleet:discocan_fleet_local@127.0.0.1:11084/discocan_fleet

# Fleet .env: guarded database tests and root test-database provisioning.
# @sensitive @type=url
FLEET_TEST_DATABASE_URL=postgresql://discocan_fleet_test:discocan_fleet_test_local@127.0.0.1:11084/discocan_fleet_test

# ERM Server .env: Prisma, ERM Server runtime and root database provisioning.
# @sensitive @type=url
ERM_DATABASE_URL=postgresql://discocan_erm:discocan_erm_local@127.0.0.1:11084/discocan_erm

# ERM Server .env: guarded database tests and root test-database provisioning.
# @sensitive @type=url
ERM_TEST_DATABASE_URL=postgresql://discocan_erm_test:discocan_erm_test_local@127.0.0.1:11084/discocan_erm_test

# Core, Fleet and ERM Server .env: development-only demo session protocol.
# Keep the same value in all three services. In production, demo login requires
# explicit true; see docs/discocan/development.md#demo-tenant-login.
# @public @type=boolean
DEMO_AUTH_ENABLED=true

# Core, Fleet and ERM Server .env: use the same signing secret in all services.
# Development-only default; production requires at least 32 characters.
# @sensitive @type=string(minLength=32)
DEMO_AUTH_SECRET=discocan-local-demo-only-change-before-deployment

# Fleet .env: startup availability of Fleet business operations.
# @public @type=boolean
FLEET_ENABLED=true

# Fleet .env: pull decoded ERM events for registered Devices every 30 seconds (ADR 0008).
# Off by default; requires ERM_TELEMETRY_URL and the same ERM_TELEMETRY_TOKEN as ERM Server.
# @public @type=boolean
FLEET_ERM_TELEMETRY_ENABLED=false

# Fleet .env: store raw eData 405 observations during the existing telemetry import.
# Off until the additive Fleet migration is deployed; does not rewind existing import cursors.
# @public @type=boolean
FLEET_ERM_EDATA_MEASUREMENTS_ENABLED=false

# Fleet .env: ERM Server api role's loopback HTTP base URL for the telemetry job.
# @public @type=url
ERM_TELEMETRY_URL=http://127.0.0.1:11017

# Fleet .env and exported Router environment: Core subgraph endpoint.
# @public @type=url
CORE_GRAPHQL_URL=http://127.0.0.1:11011/graphql

# Exported Router environment and ERM Server api/all roles: Fleet subgraph endpoint.
# ERM also uses its origin for the read-only /internal/erm-device-target queue preflight.
# @public @type=url
FLEET_GRAPHQL_URL=http://127.0.0.1:11013/graphql

# Exported Router environment: ERM Server api subgraph.
# @public @type=url
ERM_SERVER_GRAPHQL_URL=http://127.0.0.1:11017/graphql

# Exported Router and Angular proxy environment: public GraphQL loopback port.
# @public @type=port(min=1, max=65535)
ROUTER_PORT=11010

# Exported Router environment: dedicated health loopback port.
# @public @type=port(min=1, max=65535)
ROUTER_HEALTH_PORT=11016

# Exported Router environment and Fleet .env: exact browser origin.
# Fleet uses this as its fallback when ADMIN_ORIGINS is absent.
# @public @type=url
ADMIN_ORIGIN=http://127.0.0.1:11000

# Fleet .env: comma-separated exact browser origin allowlist.
# @public @type=string
ADMIN_ORIGINS=http://127.0.0.1:11000,http://localhost:11000

# ERM Server .env: all (default) combines device ingestion, the unit/command API, GraphQL
# and the read-only telemetry API. gateway runs ingestion and the unit/command API; api runs
# GraphQL and the telemetry API. recovery runs only the read-only TCP listener on 11510,
# as a separate user service; it never opens gateway/API ports or modifies device settings.
# HTTP PORT defaults to 11017 for api, 11015 otherwise.
# npm run dev in @discocan/erm-server selects api.
# @public @type=enum(all, gateway, api, recovery)
ERM_ROLE=all

# ERM Server api role: gateway's loopback HTTP base URL.
# Uses ERM_INTERNAL_TOKEN; requests are bounded and redirects are rejected.
# @public @type=url
ERM_GATEWAY_URL=http://127.0.0.1:11015

# ERM Server gateway/all roles: StarLink TCP device listener address.
# @public @type=string
ERM_DEVICE_HOST=0.0.0.0

# ERM Server .env: device TCP port, separate from the app-local HTTP PORT.
# The relay uses the same default; run them on separate ports when both are needed.
# @public @type=port(min=1, max=65535)
ERM_DEVICE_PORT=11500

# ERM Server .env: required Karma device ingestion host:port in both modes.
# @public @type=string
ERM_UPSTREAM=in.karma.online:500

# ERM Server .env: private daily JSON Lines audit directory. Relative paths resolve
# from the repository root. Frames contain vehicle positions; keep it Git-ignored.
# @public @type=string
ERM_CAPTURE_DIR=.references/erm-server

# ERM Server .env: comma-separated unit IDs that use discocan acknowledgements and commands.
# Empty keeps every unit in byte-for-byte mirror mode. Applied when a unit connects.
# @public @type=string
ERM_PRIMARY_UNITS=

# ERM Server api role: temporary Karma backup detection and explicit parked-unit return.
# The module is disabled unless KARMA_USER, KARMA_PASSWORD and ERM_RECOVERY_ENDPOINT are set.
# @public @type=url
KARMA_API_URL=https://karma.online/apiv2/

# ERM Server api role: Karma API account name; supply the real value through private configuration.
# @sensitive @type=string(minLength=1)
KARMA_USER=

# ERM Server api role: Karma API account password; never commit the real value.
# @sensitive @type=string(minLength=1)
KARMA_PASSWORD=

# ERM Server api role: public host:port units reach for the separate read-only recovery listener.
# Example: recovery.example.test:11510. Leave unset to disable detection and return.
# @public @type=string
ERM_RECOVERY_ENDPOINT=

# ERM Server .env: comma-separated device commands discocan confirms in primary mode.
# @public @type=string
ERM_ACK_COMMANDS=06

# ERM Server .env: private bearer token for loopback-only /internal/units endpoints.
# Endpoints are disabled when unset. Generate a random token of at least 32 characters.
# @sensitive @type=string(minLength=32)
ERM_INTERNAL_TOKEN=

# ERM Server api/all roles: enable controlled admin parameter/eData writes. Off by default.
# Reads remain available. A verified Branch Device, primary connection and fresh snapshot are required.
# @public @type=boolean
ERM_CONFIGURATION_WRITES_ENABLED=false

# ERM Server api/all roles and Fleet: private bearer token for loopback-only read endpoints.
# Protects ERM /internal/telemetry and Fleet /internal/erm-device-target (queued target check).
# Queue delivery needs the same value in both services; separate from ERM_INTERNAL_TOKEN.
# Both read endpoints are disabled when unset.
# @sensitive @type=string(minLength=32)
ERM_TELEMETRY_TOKEN=

# ERM Server .env: ordered event fields configured by device parameter 0177.
# Used for device 06/86 decoding in both modes; set to the unit's actual structure.
# @public @type=string
ERM_EVENT_STRUCTURE="#EDT#,#EID#,#PDT#,#LAT#,#LONG#,#SPD#,#HEAD#,#ODOD#,#LAC#,#CID#,#ENG#,#VIN#,#VBAT#,#BATC#,#BATH#,#STRT#,#TVI#,#NXT#,#ALT#,#CSS#"

# Root .env: npm run erm:relay listener for StarLink devices on all interfaces.
# @public @type=string
ERM_RELAY_HOST=0.0.0.0

# Root .env: TCP port of the ERM relay; device parameter 0050 points here through the
# public layer-4 forward.
# @public @type=port(min=1, max=65535)
ERM_RELAY_PORT=11500

# Root .env: host:port the relay forwards every device connection to (Karma ingestion).
# @public @type=string
ERM_RELAY_UPSTREAM=in.karma.online:500

# Root .env: private directory for the relay's daily JSON Lines frame capture. The frames
# contain vehicle positions; keep the directory Git-ignored.
# @public @type=string
ERM_RELAY_CAPTURE_DIR=.references/erm-relay

# Optional PORT override belongs only in the individual Node application's .env.
# Defaults: Core 11011, Fleet 11013, ERM Server 11015.
# Router uses ROUTER_PORT.
# Leave PORT unset to retain each application's default; do not export one PORT
# for the whole development group. For a Core-only override, for example:
# @public @type=port(min=1, max=65535)
# PORT=11011

# Exported only for the compiled-admin Playwright smoke checks. Set to 1 to
# enable optional shell captures and failure/trace screenshots; default 0 keeps
# textual, DOM and ARIA diagnostics. Storybook visual candidates use their own target.
# @public @type=enum(0,1)
DISCOCAN_BROWSER_SCREENSHOTS=0
