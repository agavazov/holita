# holita environment reference, using @env-spec style annotations.
# This is the only environment example/schema in the repository.
# Copy the relevant variables into the ignored root or application .env described
# below; export Router/proxy variables in the shell that launches npm.
# dotenv and Compose treat decorators as comments; no schema validator is installed.
# Safe local development defaults are shown. Keep existing installation secrets.
# Store real credentials in the shared services/.credentials or project-local
# .credentials directory documented in AGENTS.local.md. Supply them through the
# consuming process environment or its ignored runtime .env.
# See docs/development.md#ports-and-environment for consumers and precedence.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# PostgreSQL host port. Root .env: Compose and database provisioning.
# Keep all database URLs below aligned with this port.
# @public @type=port(min=1, max=65535)
POSTGRES_PORT=11084

# PostgreSQL provisioning password. Root .env: Compose and database provisioning.
# Development-only default; preserve the password of an initialized database.
# @sensitive @type=string(minLength=1)
POSTGRES_PASSWORD=holita_admin_local

# Core .env: Prisma, Core runtime and root database provisioning.
# Application database credentials are separate from the provisioning role.
# @sensitive @type=url
CORE_DATABASE_URL=postgresql://holita_core:holita_core_local@127.0.0.1:11084/holita_core

# Core .env: guarded database tests and root test-database provisioning.
# Tests require the dedicated test role/database, never the development URL.
# @sensitive @type=url
CORE_TEST_DATABASE_URL=postgresql://holita_core_test:holita_core_test_local@127.0.0.1:11084/holita_core_test

# Fleet .env: Prisma, Fleet runtime and root database provisioning.
# @sensitive @type=url
FLEET_DATABASE_URL=postgresql://holita_fleet:holita_fleet_local@127.0.0.1:11084/holita_fleet

# Fleet .env: guarded database tests and root test-database provisioning.
# @sensitive @type=url
FLEET_TEST_DATABASE_URL=postgresql://holita_fleet_test:holita_fleet_test_local@127.0.0.1:11084/holita_fleet_test

# Core, Fleet and Karma Client .env: development-only demo session protocol.
# Keep the same value in all three services. In production, demo login requires
# explicit true; see docs/discocan/development.md#demo-tenant-login.
# @public @type=boolean
DEMO_AUTH_ENABLED=true

# Core, Fleet and Karma Client .env: use the same signing secret in all services.
# Development-only default; production requires at least 32 characters.
# @sensitive @type=string(minLength=32)
DEMO_AUTH_SECRET=holita-local-demo-only-change-before-deployment

# Fleet .env: startup availability of Fleet business operations.
# @public @type=boolean
FLEET_ENABLED=true

# Fleet .env and exported Router environment: Core subgraph endpoint.
# @public @type=url
CORE_GRAPHQL_URL=http://127.0.0.1:11011/graphql

# Exported Router environment: Fleet subgraph endpoint.
# @public @type=url
FLEET_GRAPHQL_URL=http://127.0.0.1:11013/graphql

# Exported Router environment: Karma Client subgraph endpoint.
# @public @type=url
KARMA_CLIENT_GRAPHQL_URL=http://127.0.0.1:11014/graphql

# Exported Router and Angular proxy environment: public GraphQL loopback port.
# @public @type=port(min=1, max=65535)
ROUTER_PORT=11010

# Exported Router environment: dedicated health loopback port.
# @public @type=port(min=1, max=65535)
ROUTER_HEALTH_PORT=11016

# Exported Router environment and Fleet .env: exact browser origin.
# Fleet uses this as its fallback when ADMIN_ORIGINS is absent.
# @public @type=url
ADMIN_ORIGIN=http://127.0.0.1:11000

# Fleet .env: comma-separated exact browser origin allowlist.
# @public @type=string
ADMIN_ORIGINS=http://127.0.0.1:11000,http://localhost:11000

# Karma Client .env: upstream API base URL. HTTP(S), without embedded credentials,
# query or fragment. Redirects are rejected.
# @public @type=url
KARMA_API_URL=https://karma.online/apiv2/

# Karma Client .env: shared upstream account. Both user and password are required
# for Karma queries; health remains available without them. No real values here.
# @sensitive @type=string
KARMA_USER=

# Karma Client .env: password for the same account.
# @sensitive @type=string
KARMA_PASSWORD=

# Optional PORT override belongs only in the individual Node application's .env.
# Defaults: Core 11011, Fleet 11013, Karma Client 11014. Router uses ROUTER_PORT.
# Leave PORT unset to retain each application's default; do not export one PORT
# for the whole development group. For a Core-only override, for example:
# @public @type=port(min=1, max=65535)
# PORT=11011
