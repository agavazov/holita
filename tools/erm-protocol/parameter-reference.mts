import { readdir, readFile, writeFile } from 'node:fs/promises';
import { join } from 'node:path';

// Regenerates apps/erm-server/src/starlink/parameter-reference.ts from the archived StarLink
// parameter pages (P*.md). Run from the repository root:
//   node --import tsx tools/erm-protocol/parameter-reference.mts
const pages = 'docs/discocan/erm-resources/starlink-online-protocol/authenticated/pages';
const output = 'apps/erm-server/src/starlink/parameter-reference.ts';

function plain(text: string): string {
  return text
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/<br>/g, ' ')
    .replace(/[`*]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function clip(text: string, length: number): string {
  return text.length > length ? `${text.slice(0, length - 1).trimEnd()}…` : text;
}

function related(markdown: string, labels: readonly string[]): string[] {
  const line = markdown.split('\n').find((entry) => labels.some((label) => entry.includes(label)));
  if (!line) {
    return [];
  }
  return line.split('<br>').flatMap((part) => {
    const label = labels.find((entry) => part.trimStart().startsWith(entry));
    return label
      ? [...part.matchAll(/\[([^\]]+)\]\([^)]*\)|([^,[\]]+)/g)]
          .map((match) => plain(match[1] ?? match[2] ?? ''))
          .filter((name) => name && !labels.some((entry) => name.startsWith(entry.trim())))
      : [];
  });
}

function options(markdown: string): { value: string; label: string }[] {
  const lines = markdown.split('\n');
  const header = lines.findIndex((line) => /^\| Value \|/.test(line));
  if (header < 0) {
    return [];
  }
  const rows: { value: string; label: string }[] = [];
  for (const line of lines.slice(header + 2)) {
    if (!line.startsWith('|')) {
      break;
    }
    const cells = line.split('|').slice(1, -1).map(plain);
    const value = cells[0] ?? '';
    if (!/^-?[\w.]{1,16}$/.test(value)) {
      return [];
    }
    rows.push({ value, label: clip(cells[1] ?? '', 120) });
  }
  return rows;
}

const entries = [];
for (const file of (await readdir(pages)).filter((name) => /^P\d+\.md$/.test(name))) {
  const markdown = await readFile(join(pages, file), 'utf8');
  const title = /^# (\d{4}) - (.+)$/m.exec(markdown);
  if (!title?.[1] || !title[2]) {
    continue;
  }
  const body = markdown.split('\n## ')[0] ?? '';
  const summary = body
    .split('\n\n')
    .slice(1)
    .map(plain)
    .find(
      (paragraph) =>
        paragraph &&
        !paragraph.startsWith('Source:') &&
        !paragraph.startsWith('Portal update') &&
        !paragraph.startsWith('Archive index') &&
        !paragraph.startsWith('|'),
    );
  const defaultValue = /^Default value: (.+)$/m.exec(markdown)?.[1];
  entries.push({
    parameter: Number(title[1]),
    title: plain(title[2]),
    summary: summary ? clip(summary, 240) : null,
    defaultValue: defaultValue ? clip(plain(defaultValue), 80) : null,
    features: [
      ...new Set(related(markdown, ['Feature: ', 'Features: ', 'Accessory: ', 'Accessories: '])),
    ],
    options: options(markdown),
  });
}
entries.sort((left, right) => left.parameter - right.parameter);

await writeFile(
  output,
  `// Generated by tools/erm-protocol/parameter-reference.mts from the archived StarLink parameter
// pages (${pages}). Regenerate instead of editing.
export interface ParameterReference {
  parameter: number;
  title: string;
  summary: string | null;
  defaultValue: string | null;
  features: readonly string[];
  options: readonly { value: string; label: string }[];
}

export const parameterReference: readonly ParameterReference[] = ${JSON.stringify(entries, null, 2)};
`,
);
console.log(`${String(entries.length)} parameters written to ${output}`);
